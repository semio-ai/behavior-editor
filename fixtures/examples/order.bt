# Order within a tick: write v, read v × 10, write again, read again.
sequence
  {v} = add(operand_0: @inc._ret)
  equal(a: @ok._ret, b: true)
  {v} = add(operand_0: @inc._ret)
  equal(a: @ok._ret, b: true)

inc: add(operand_0: {v}, operand_1: 1f32)
scaled: multiply(operand_0: {v}, operand_1: 10f32)
ok: lessthan(lhs: @scaled._ret, rhs: 1000000f32)
