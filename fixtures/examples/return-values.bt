# Return values: `@name._ret` reads the return value (`_ret`) of the node named
# `name`, `{key} = …` writes a node's return value to the store, and a nested
# call hands its return value straight to the parameter it fills.
fallback
  sequence
    equal(a: @near._ret, b: true)
    {face/look} = add(operand_0: @level._ret)
  {face/look} = add(operand_0: 0f32)

near: lessthan(lhs: {sensor/distance}, rhs: 0.5f32)
cm: clamp(in: multiply(operand_0: {sensor/distance}, operand_1: 100f32), min: 0f32, max: 50f32)
level: {face/level} = add(operand_0: @cm._ret, operand_1: 1f32)
