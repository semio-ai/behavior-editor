# Three readers of one value, all asked: the cascade runs once for the three.
parallel
  truthy(x: @near._ret)
  truthy(x: @mid._ret)
  truthy(x: @far._ret)

raw: mul(a: {sensor/distance}, b: 100)
cm: clamp(x: @raw._ret, min: 0, max: 1000)
near: lt(a: @cm._ret, b: 10)
mid: lt(a: @cm._ret, b: 30)
far: lt(a: @cm._ret, b: 50)
