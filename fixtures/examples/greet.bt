# Greet, then rest: control around dataflow. A leaf whose return value goes to
# a key writes it each time it ticks, and succeeds; a damp whose state is a key
# eases that key from wherever it is.
fallback  # greet or rest
  sequence  # greet
    equal(a: {person/visible}, b: true)
    equal(a: @fresh._ret, b: true)  # not greeted yet
    parallel  # wave until two seconds have passed
      damp(in: 1f32, param.half_life: 0.12f32, dt: {arora/dt}, state: {rig/arm_raise})
      {rig/arm_wave} = multiply(operand_0: oscillator(frequency: 1.6f32, t: {arora/time}), operand_1: 0.6f32)
      fallback  # wait
        equal(a: @waved._ret, b: true)
        running
    {social/greeted} = not(in: false)
  parallel  # rest
    damp(in: 0f32, param.half_life: 0.2f32, dt: {arora/dt}, state: {rig/arm_raise})
    damp(in: 0f32, param.half_life: 0.2f32, dt: {arora/dt}, state: {rig/arm_wave})
    {social/rested_at} = time(t: {arora/time})  # a greeting starts from the last rest

fresh: not(in: {social/greeted})
waved: greaterthan(lhs: subtract(lhs: time(t: {arora/time}), rhs: {social/rested_at}), rhs: 2f32)  # two seconds since the last rest
