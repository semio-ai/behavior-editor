# Three readers of one value, all asked: the cascade runs once for the three.
parallel
  equal(a: @near._ret, b: true)
  equal(a: @mid._ret, b: true)
  equal(a: @far._ret, b: true)

raw: multiply(operand_0: {sensor/distance}, operand_1: 100f32)
cm: clamp(in: @raw._ret, min: 0f32, max: 1000f32)
near: lessthan(lhs: @cm._ret, rhs: 10f32)
mid: lessthan(lhs: @cm._ret, rhs: 30f32)
far: lessthan(lhs: @cm._ret, rhs: 50f32)
